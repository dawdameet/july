{
  "project": "july",
  "target": "192.168.1.41:8080",
  "build": [
    "make clean",
    "make -j4",
    "mkdir -p dist && cp server dispatcher dist/"
  ],
  "artifacts": [
    "dist/server",
    "dist/dispatcher"
  ],
  "ignore": [
    ".git*",
    "*.o",
    "*.bin",
    ".july*",
    "*.dSYM",
    ".DS_Store",
    "server",
    "dispatcher",
    "dispatch",
    "picture",
    "app",
    "dist"
  ]
}
